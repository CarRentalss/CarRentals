<Project>
  <!-- Wspólne ustawienia dla wszystkich projektów w solucji -->
  <PropertyGroup>
    <!-- Domyślnie .NET 10 (LTS). Na komputerze tylko z .NET 8 SDK: dotnet test -p:AppTargetFramework=net8.0 -->
    <AppTargetFramework Condition="'$(AppTargetFramework)' == ''">net10.0</AppTargetFramework>
    <AspNetPackagesVersion Condition="'$(AppTargetFramework)' == 'net8.0'">8.0.*</AspNetPackagesVersion>
    <AspNetPackagesVersion Condition="'$(AspNetPackagesVersion)' == ''">10.0.*</AspNetPackagesVersion>
    <!-- System.Security.Cryptography.Pkcs: SqlClient ciągnie podatną 9.0.11 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7).
         Wersję wymuszamy w obu API przez $(PkcsVersion). -->
    <PkcsVersion Condition="'$(PkcsVersion)' == '' And '$(AppTargetFramework)' == 'net8.0'">9.0.*</PkcsVersion>
    <PkcsVersion Condition="'$(PkcsVersion)' == ''">10.0.*</PkcsVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Analizatory Roslyn (wymaganie: statyczna analiza kodu) -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
