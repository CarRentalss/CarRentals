{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CarRentalDb": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "ApiKeys": {
    "Clients": []
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": ""
  },
  "Pricing": {
    "YoungDriverAgeLimit": 25,
    "YoungDriverMultiplier": 1.25,
    "NewDriverYearsLimit": 3,
    "NewDriverMultiplier": 1.20,
    "MaxRentalDays": 30,
    "Currency": "PLN"
  },
  "Offers": {
    "ValidityMinutes": 10
  },
  "RentalProcessing": {
    "Enabled": true,
    "ConfirmationDelaySeconds": 10,
    "PollIntervalSeconds": 5
  },
  "Storage": {
    "LocalPath": "App_Data/attachments"
  }
}
