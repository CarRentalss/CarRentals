        {
          "name": "8. Pracownik: wynajmy do odbioru",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-Employee",
                "value": "{{devEmployee}}"
              },
              {
                "key": "X-Dev-Roles",
                "value": "Employee"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employee/rentals?status=ReturnRequested",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employee",
                "rentals"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ReturnRequested"
                }
              ]
            },
            "description": "Lokalnie (Development, bez AzureAd) pracownik loguje się nagłówkami X-Dev-Employee i X-Dev-Roles. W Azure potrzebny jest token z Entra z rolą Employee."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"nasz wynajem jest na liście do odbioru\", () => {",
                  "    pm.expect(list.map(r => r.rentalId)).to.include(pm.collectionVariables.get(\"rentalId\"));",
                  "});",
                  "pm.test(\"wszystkie mają status ReturnRequested\", () => list.forEach(r => pm.expect(r.status).to.eql(\"ReturnRequested\")));"
                ]
              }
            }
          ]
        },
