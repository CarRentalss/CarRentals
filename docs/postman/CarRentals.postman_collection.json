        {
          "name": "10. Pracownik: potwierdzenie zwrotu (notatka + PDF)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Employee",
                "value": "{{devEmployee}}"
              },
              {
                "key": "X-Dev-Roles",
                "value": "Employee"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=----CarRentalsBoundary7MA4YWxkTrZu0gW"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employee/rentals/{{rentalId}}/confirm-return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employee",
                "rentals",
                "{{rentalId}}",
                "confirm-return"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "------CarRentalsBoundary7MA4YWxkTrZu0gW\r\nContent-Disposition: form-data; name=\"Note\"\r\n\r\nAuto oddane czyste, bez uszkodzeń, pełny bak.\r\n------CarRentalsBoundary7MA4YWxkTrZu0gW\r\nContent-Disposition: form-data; name=\"File\"; filename=\"protokol-zwrotu.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.4\n% Protokol zwrotu auta (plik testowy z Postmana)\n%%EOF\r\n------CarRentalsBoundary7MA4YWxkTrZu0gW--\r\n"
            },
            "description": "Body to gotowy multipart/form-data z notatką i małym plikiem PDF (zaczyna się od %PDF, API sprawdza pierwsze bajty). Dzięki temu kolekcja nie potrzebuje pliku na dysku. Można też przełączyć Body na form-data i wybrać własny plik jpg, png albo pdf (pola Note i File)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status Completed\", () => pm.expect(pm.response.json().status).to.eql(\"Completed\"));"
                ]
              }
            }
          ]
        },
