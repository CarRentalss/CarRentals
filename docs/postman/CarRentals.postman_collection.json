          "name": "Wycena (anonimowo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF",
                "value": "1"
              }
            ],
            "url": {
              "raw": "{{brokerUrl}}/api/v1/offers",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "offers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"our\",\n  \"carId\": \"1\",\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"age\": 30,\n  \"licenseYears\": 8,\n  \"location\": \"Warszawa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Termin daleko w przyszłości i losowy, żeby kolejne przebiegi nie trafiały na zajęte auto (409)",
                  "const offset = 40 + Math.floor(Math.random() * 300);",
                  "const start = new Date();",
                  "start.setUTCDate(start.getUTCDate() + offset);",
                  "const end = new Date(start);",
                  "end.setUTCDate(end.getUTCDate() + 3);",
                  "const fmt = d => d.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set(\"startDate\", fmt(start));",
                  "pm.collectionVariables.set(\"endDate\", fmt(end));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"jest oferta z naszej wypożyczalni\", () => {",
                  "    pm.expect(res.offers).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(res.offers[0]).to.include.all.keys(\"quoteId\", \"provider\", \"offerId\", \"dailyPrice\", \"dailyInsurancePrice\", \"totalPrice\", \"expiresAt\");",
                  "});",
                  "pm.test(\"nikt nie został pominięty\", () => pm.expect(res.skippedProviders).to.be.an(\"array\").that.is.empty);",
                  "pm.test(\"odpowiedź w mniej niż 15 s\", () => pm.expect(pm.response.responseTime).to.be.below(15000));"
                ]
              }
            }
          ]
        },
